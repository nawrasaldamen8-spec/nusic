    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>05e44cc1-f330-47fb-a50c-eaeaece4118a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Nusic.Api.Tests/**" />
